{
  "name": "persistara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Owner-controlled agents with recoverable memory, durable missions, and bounded commerce on NEAR.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "pnpm build && node --test dist/tests/*.test.js",
    "check": "pnpm typecheck && pnpm test",
    "runtime:test": "pnpm build && node --test dist/tests/missions.test.js dist/tests/commerce.test.js dist/tests/specialist.test.js dist/tests/commerce-http.test.js",
    "missions:recover:fixture": "pnpm build && node dist/scripts/mission-recovery-fixture.js",
    "specialist": "pnpm build && node dist/scripts/specialist.js",
    "web:build": "tsc -p apps/console/tsconfig.json && tsc -p apps/console/tsconfig.test.json && vite build --config apps/console/vite.config.ts",
    "owner:console": "pnpm build && pnpm web:build && node dist/scripts/owner-console.js",
    "test:e2e": "pnpm build && pnpm web:build && playwright test --config apps/console/playwright.config.ts",
    "provider:doctor": "pnpm build && node dist/scripts/provider-doctor.js",
    "near:doctor": "pnpm build && node dist/scripts/near-doctor.js",
    "near:reconcile": "pnpm build && node dist/scripts/near-reconcile.js",
    "near:acceptance": "pnpm build && node dist/scripts/near-acceptance.js",
    "owner:rotation:prepare": "pnpm build && node dist/scripts/owner-rotation.js prepare",
    "owner:rotation:next": "pnpm build && node dist/scripts/owner-rotation.js next",
    "owner:rotation:verify": "pnpm build && node dist/scripts/owner-rotation.js verify",
    "owner:rotation:abort": "pnpm build && node dist/scripts/owner-rotation.js abort",
    "recovery:kit": "pnpm build && node dist/scripts/recovery-kit.js",
    "memory:keys": "pnpm build && node dist/scripts/memory.js keys",
    "conversations:backup": "pnpm build && node dist/scripts/conversation-backup.js backup",
    "conversations:backup:verify": "pnpm build && node dist/scripts/conversation-backup.js verify",
    "conversations:restore": "pnpm build && node dist/scripts/conversation-backup.js restore",
    "memory:backup": "pnpm build && node dist/scripts/memory.js backup",
    "memory:backup:verify": "pnpm build && node dist/scripts/memory.js verify-backup",
    "memory:recover": "pnpm build && node dist/scripts/memory.js recover",
    "memory:recall": "pnpm build && node dist/scripts/memory.js recall",
    "memory:recover:fixture": "pnpm build && node dist/scripts/memory-recovery-fixture.js",
    "memory:write": "pnpm build && node dist/scripts/memory-write.js write",
    "memory:resume": "pnpm build && node dist/scripts/memory-write.js resume",
    "memory:writes:reconcile": "pnpm build && node dist/scripts/memory-write.js reconcile",
    "memory:writes:cancel": "pnpm build && node dist/scripts/memory-write.js cancel",
    "memory:writes:fixture": "pnpm build && node dist/scripts/memory-write-fixture.js",
    "storage:wallet": "pnpm build && node dist/scripts/storage-wallet.js",
    "inference:models": "pnpm build && node dist/scripts/inference-models.js",
    "spike:storage": "pnpm build && node dist/scripts/storage-roundtrip.js",
    "storage:acceptance": "pnpm build && node dist/scripts/storage-acceptance.js",
    "spike:inference": "pnpm build && node dist/scripts/inference-verify.js",
    "contract:build": "cargo near build non-reproducible-wasm --manifest-path contracts/authority/Cargo.toml --locked --no-abi",
    "contract:test": "cargo test -p persistara-authority --locked",
    "contract:sandbox": "pnpm build && pnpm contract:build && cargo test -p persistara-contract-tests --features sandbox --locked -- --test-threads=1",
    "contract:check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --features sandbox --locked -- -D warnings && pnpm contract:test && pnpm contract:sandbox",
    "cli": "./bin/persistara",
    "cli:dev": "pnpm build && ./bin/persistara"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "1.2.13",
    "@hot-labs/near-connect": "0.12.0",
    "@nearai/inference-sdk": "0.2.1",
    "ethers": "6.13.1",
    "ink": "8.0.0",
    "jose": "6.2.15",
    "near-api-js": "7.4.0",
    "react": "19.3.1",
    "string-width": "8.3.0",
    "wrap-ansi": "10.0.2"
  },
  "bin": {
    "persistara": "bin/persistara"
  }
}
