# Galileo testnet only. Use a dedicated uploader wallet, never an owner wallet.
ZG_STORAGE_MODE=turbo
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ZG_UPLOADER_KEY_FILE=.persistara/keys/0g-uploader.key

# Create an API key and add credits at https://cloud.near.ai.
# Candidate observed in the current catalog; strict attestation/tool checks still apply.
NEARAI_API_KEY=
NEARAI_MODEL=z-ai/glm-5.3-flash

# Public NEAR testnet deployment remains a release gate. Use a separate function-call key.
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_AUTHORITY_CONTRACT=
NEAR_OWNER_ACCOUNT=
NEAR_AGENT_ID=
NEAR_RUNTIME_PUBLIC_KEY=
# Set to the agent ID (name.owner) only when the runtime key lives on the agent's own account; pnpm near:deploy prints it. Leave empty for the older layout with the key on the owner account.
NEAR_RUNTIME_ACCOUNT=
NEAR_RUNTIME_KEY_FILE=.persistara/keys/near-runtime.key
# Optional: default is one private journal per runtime key, bound to this agent/contract.
NEAR_JOURNAL_FILE=

# Optional exact origins for unauthenticated, zero-spend source-dossier missions.
# Queries, credentials, custom ports, private networks and redirects are rejected.
PERSISTARA_SOURCE_ORIGINS=https://docs.near.org,https://docs.0g.ai,https://raw.githubusercontent.com

# Optional curated specialist: public identity only; wallet stays in external NEAR CLI.
PERSISTARA_SPECIALIST_ACCOUNT=
PERSISTARA_SPECIALIST_SIGNING_KEY=
PERSISTARA_SPECIALIST_PROFILE=
PERSISTARA_SPECIALIST_STATE_DIR=.persistara/specialist
PERSISTARA_SPECIALIST_PRICE_YOCTO=10000000000000000000000
NEAR_CLI_BIN=near
# Optional, off by default: stream the model reply (still fully verified before use). Unaccepted against the live provider.
# NEARAI_STREAM=enabled
